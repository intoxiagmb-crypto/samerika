# Vercel production and preview: use a Turso libSQL database and a PRIVATE Blob store.
# Never prefix these names with NEXT_PUBLIC_. Use separate databases/stores for previews.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
BLOB_READ_WRITE_TOKEN=

# Local development defaults to ignored .solaris/local.db and .solaris/files.
# Only for testing `next start` locally; ignored whenever VERCEL is set.
# SOLARIS_LOCAL_DATA=1
